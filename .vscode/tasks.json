{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Jekyll: Build",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File ./scripts/build-site.ps1",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Jekyll: Serve (livereload)",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -NoExit -File ./scripts/serve-site.ps1",
      "group": "none",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
